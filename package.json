{
	"name": "tracostume",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:phone": "DEV_HTTPS=1 vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"postinstall": "svelte-kit sync && prisma generate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"start": "node --env-file-if-exists=.env build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"dotenv": "^18.0.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "^7.10.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1155.0",
		"@aws-sdk/s3-request-presigner": "^3.1155.0",
		"@huggingface/transformers": "^4.3.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"barcode-detector": "^3.2.3",
		"bcryptjs": "^3.0.3",
		"date-fns": "^4.4.0",
		"pg": "^8.23.1",
		"qrcode": "^1.5.4",
		"three": "^0.186.1",
		"zod": "^4.6.7",
		"zxing-wasm": "^3.1.6"
	},
	"allowScripts": {
		"@prisma/engines@7.10.1": true,
		"esbuild@0.28.2": true,
		"prisma@7.10.1": true,
		"onnxruntime-node@1.30.0": true,
		"protobufjs@7.6.6": true
	},
	"engines": {
		"node": ">=22"
	}
}
