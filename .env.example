# Port 5433 so it can run next to Tracster's database on 5432.
DATABASE_URL="postgresql://tracostume:tracostume@localhost:5433/tracostume"
# Optional. When set, registration asks for this password before the account form.
REGISTERING_PASSWORD=""
# QR codes encode <site URL>/q/<code>: print labels from the production site, not from localhost.
# In production the site URL comes from the request (HTTPS assumed, as on Railway).
PUBLIC_APP_NAME="Tracostume"
# Max request body size for photo uploads (photos are resized in the browser first).
BODY_SIZE_LIMIT="10M"

# Photo storage. When the bucket is not configured, photos are stored on disk in UPLOADS_DIR.
# On Railway, insert the AWS SDK variable preset from the bucket.
UPLOADS_DIR="./data/uploads"
# Semantic search model (multilingual-e5-small, ~130 MB) is downloaded here on first use.
MODELS_DIR="./data/models"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL="https://storage.railway.app"
AWS_S3_BUCKET_NAME=""
AWS_DEFAULT_REGION="auto"
# AWS_S3_URL_STYLE="path"
