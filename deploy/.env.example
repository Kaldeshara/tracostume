# Copy to deploy/.env (untracked). Generate the password with: openssl rand -hex 24
POSTGRES_PASSWORD=
PUBLIC_APP_NAME=TRACostume
# Optional: a password new members must know to register.
REGISTERING_PASSWORD=
# Tailscale auth key for the "tracostume" node (one-off, pre-approved). Used once: the node's
# identity is then kept in the ts-state volume, and the key can be removed from this file.
TS_AUTHKEY=
