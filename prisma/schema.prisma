generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// DANCER: gallery and own loans. REPAIRER: only pieces to wash/repair. CHOREOGRAPHER: lends
/// pieces to dancers and collects them back. KEEPER: holds the container key, manages stock.
/// ADMIN and OWNER also manage members.
enum UserRole {
  DANCER
  REPAIRER
  CHOREOGRAPHER
  KEEPER
  ADMIN
  OWNER
}

enum DisplayLanguage {
  ENGLISH
  FRENCH
}

enum ItemCondition {
  GOOD
  TO_WASH
  TO_REPAIR
  IN_REPAIR
  DAMAGED
  LOST
  RETIRED
}

/// What a storage unit physically is; drives its look on the 3D map. RACK is a clothes rail.
enum BoxKind {
  PLASTIC_BOX
  CARDBOARD_BOX
  CANVAS_BAG
  RACK
  OTHER
}

/// Wall of the container holding the door, as seen on the 3D map (FRONT = y max).
enum DoorSide {
  FRONT
  BACK
  LEFT
  RIGHT
}

/// Type of a piece; grouped and translated in src/lib/categories.ts.
enum ItemCategory {
  T_SHIRT
  SHIRT
  TANK_TOP
  BODYSUIT
  SWEATER
  VEST
  POLO
  CROP_TOP
  CORSET
  TUNIC
  TOP_OTHER
  TROUSERS
  JEANS
  SHORTS
  SKIRT
  LEGGINGS
  BOTTOM_OTHER
  DRESS
  JUMPSUIT
  DUNGAREES
  SET
  FULL_COSTUME
  JACKET
  BLAZER
  COAT
  CAPE
  TAILCOAT
  TRACKSUIT
  OUTERWEAR_OTHER
  HAT
  TOP_HAT
  CAP
  HOOD
  WIG
  HEADWEAR_OTHER
  SCARF
  BELT
  GLOVES
  MASK
  SOCKS
  JEWELRY
  BOA
  PROP
  DECORATION
  ACCESSORY_OTHER
  SHOES
  BOOTS
  FOOTWEAR_OTHER
  UNSORTED
}

enum MovementType {
  CREATED
  STORED
  MOVED
  CHECKED_OUT
  /// Handed back by the dancer to the choreographer, not yet in the container.
  COLLECTED
  RETURNED
  CONDITION_CHANGED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  firstName       String
  lastName        String
  phone           String?
  role            UserRole         @default(DANCER)
  displayLanguage DisplayLanguage?
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions       Session[]
  passwordResets PasswordReset[]
  itemLists      ItemList[]
  pushSubscriptions PushSubscription[]
  borrowedLoans  Loan[]      @relation("LoanBorrower")
  createdLoans   Loan[]      @relation("LoanCreator")
  returnedLoans  Loan[]      @relation("LoanReturner")
  contactLoans   Loan[]      @relation("LoanContact")
  collectedLoans Loan[]      @relation("LoanCollector")
  movements      Movement[]
  uploadedPhotos ItemPhoto[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One-time link an admin sends to a member who forgot their password. Only a hash of the token
/// is stored; the link works once, until expiresAt.
model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Dimensions and positions are in centimetres and optional until the container is measured.
/// They feed the future 3D view.
model Container {
  id          String   @id @default(cuid())
  name        String
  description String?
  widthCm     Int?
  depthCm     Int?
  heightCm    Int?
  doorSide    DoorSide @default(FRONT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boxes Box[]
}

model Box {
  id          String   @id @default(cuid())
  /// Value encoded in the QR code label.
  code        String   @unique
  label       String
  description String?
  kind        BoxKind  @default(PLASTIC_BOX)
  containerId String
  /// Free-text position for humans, e.g. "Left shelf, top".
  shelf       String?
  posXCm      Int?
  posYCm      Int?
  posZCm      Int?
  widthCm     Int?
  depthCm     Int?
  heightCm    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  container     Container  @relation(fields: [containerId], references: [id], onDelete: Restrict)
  items         Item[]
  movementsFrom Movement[] @relation("MovementFromBox")
  movementsTo   Movement[] @relation("MovementToBox")

  @@index([containerId])
}

model Item {
  id          String        @id @default(cuid())
  /// Value encoded in the QR code label. Every physical piece has its own code,
  /// even when several pieces are identical.
  code        String        @unique
  name        String
  description String?
  category    ItemCategory  @default(UNSORTED)
  color       String?
  size        String?
  condition   ItemCondition @default(GOOD)
  /// Null while the item is outside (open loan) or not yet stored.
  boxId       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  box       Box?           @relation(fields: [boxId], references: [id], onDelete: SetNull)
  photos    ItemPhoto[]
  embedding ItemEmbedding?
  tags      ItemTag[]
  loans     Loan[]
  movements Movement[]
  lists     ItemListEntry[]

  @@index([boxId])
  @@index([category])
}

model ItemPhoto {
  id           String   @id @default(cuid())
  itemId       String
  /// Several photos may share one stored file (identical pieces imported from one picture).
  storageKey   String
  mimeType     String
  width        Int?
  height       Int?
  position     Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  item       Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([itemId, position])
  @@index([storageKey])
}

/// Semantic-search vector of an item's text, refreshed when the text changes (see embeddings.ts).
model ItemEmbedding {
  itemId    String   @id
  model     String
  textHash  String
  vector    Bytes
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  items ItemTag[]
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

/// SET: pieces worn together (dress + hat + boa). SHOW: everything prepared for one show.
enum ItemListKind {
  SET
  SHOW
}

/// A named, shared list of pieces: a costume set or a show's preparation list. Loading it into the
/// selection gives the usual "where are they?", map, labels and bulk check-out.
model ItemList {
  id          String       @id @default(cuid())
  name        String
  kind        ItemListKind @default(SHOW)
  description String?
  /// Date of the show, for SHOW lists.
  date        DateTime?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries   ItemListEntry[]
}

model ItemListEntry {
  listId  String
  itemId  String
  addedAt DateTime @default(now())

  list ItemList @relation(fields: [listId], references: [id], onDelete: Cascade)
  item Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([listId, itemId])
  @@index([itemId])
}

/// An item lent outside the container. Open while returnedAt is null.
/// The borrower is either a registered user or just a name (dancers without an account).
model Loan {
  id             String    @id @default(cuid())
  itemId         String
  borrowerUserId String?
  borrowerName   String?
  borrowerPhone  String?
  reason         String?
  checkedOutAt   DateTime  @default(now())
  dueAt          DateTime?
  /// Choreographer in charge of getting the piece back from the dancer.
  contactUserId  String?
  /// When the choreographer got the piece back from the dancer (still outside the container).
  collectedAt    DateTime?
  collectedById  String?
  returnedAt     DateTime?
  createdById    String?
  returnedById   String?

  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrowerUser User?      @relation("LoanBorrower", fields: [borrowerUserId], references: [id], onDelete: SetNull)
  contactUser  User?      @relation("LoanContact", fields: [contactUserId], references: [id], onDelete: SetNull)
  collectedBy  User?      @relation("LoanCollector", fields: [collectedById], references: [id], onDelete: SetNull)
  createdBy    User?      @relation("LoanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  returnedBy   User?      @relation("LoanReturner", fields: [returnedById], references: [id], onDelete: SetNull)
  movements    Movement[]

  @@index([itemId, returnedAt])
  @@index([returnedAt, dueAt])
}

/// Append-only history of everything that happened to an item.
model Movement {
  id            String         @id @default(cuid())
  itemId        String
  type          MovementType
  fromBoxId     String?
  toBoxId       String?
  loanId        String?
  fromCondition ItemCondition?
  toCondition   ItemCondition?
  note          String?
  userId        String?
  createdAt     DateTime       @default(now())

  item    Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  loan    Loan? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  fromBox Box?  @relation("MovementFromBox", fields: [fromBoxId], references: [id], onDelete: SetNull)
  toBox   Box?  @relation("MovementToBox", fields: [toBoxId], references: [id], onDelete: SetNull)
  user    User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
}

/// A phone or browser that receives reminders (Web Push). Its language is the app's language
/// when it subscribed.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("fr")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The server's VAPID key pair for Web Push, created on first use (one row, id 1).
model PushKeys {
  id         Int      @id @default(1)
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

/// Days on which the daily loan reminders were sent (yyyy-mm-dd, Paris time), so a restart does
/// not send them twice.
model ReminderRun {
  day    String   @id
  sentAt DateTime @default(now())
}
